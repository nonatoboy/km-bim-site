---
// Projeção da enquete em tela cheia: /enquete/projecao?t={token}. Link secreto, sem login;
// o palestrante conduz pelo painel e esta tela acompanha (consulta a cada 1,5 s).
import '@fontsource/saira/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../../styles/global.css';
import '../../styles/enquete.css';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>Projeção · Enquete · KM BIM</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="projecao">
  <header class="projecao__barra">
    <img src="/img/km-bim-horizontal-negativo.svg" alt="KM BIM" class="projecao__logo" />
    <div class="projecao__acesso" id="acesso" hidden>
      <p>Acesse <strong data-endereco></strong><br />e use o código</p>
      <strong class="projecao__codigo" data-codigo></strong>
      <div class="projecao__qr-mini" data-qr></div>
    </div>
  </header>

  <main id="palco" class="projecao__palco">
    <p class="projecao__aviso">Carregando…</p>
  </main>

  <footer class="projecao__rodape">
    <span id="contagem"></span>
    <button type="button" id="tela-cheia" class="projecao__botao">Tela cheia (F)</button>
  </footer>

  <script>
    import { iniciarProjecao } from '../../scripts/projecao';
    import { supabaseConfigurado } from '../../lib/supabase';
    if (supabaseConfigurado) iniciarProjecao();
    else document.getElementById('palco')!.innerHTML = '<p class="projecao__aviso">Supabase não configurado.</p>';
  </script>
</body>
</html>

<style is:global>
  body.projecao {
    --res-texto: var(--km-nevoa);
    --res-suave: #A9BBC1;
    --res-trilho: rgba(238, 243, 244, .12);
    --res-barra: var(--km-ciano);
    --res-tom-0: var(--km-nevoa);
    --res-tom-1: var(--km-ciano);
    --res-tom-2: var(--km-ambar);
    --res-tom-3: #7FD3DD;
    height: 100vh; height: 100dvh; overflow: hidden;
    display: grid; grid-template-rows: auto minmax(0, 1fr) auto;
    background: var(--km-grafite); color: var(--km-nevoa);
    font-size: clamp(16px, 1.6vw, 34px);
  }
  .projecao__barra { display: flex; justify-content: space-between; align-items: center; gap: 1em; padding: 0.9em 1.6em; border-bottom: 1px solid rgba(238, 243, 244, .12); }
  .projecao__logo { height: 1.8em; width: auto; }
  .projecao__acesso { display: flex; align-items: center; gap: 0.8em; }
  .projecao__acesso p { text-align: right; font-size: 0.8em; line-height: 1.3; color: #A9BBC1; }
  .projecao__acesso p strong { color: var(--km-nevoa); }
  .projecao__codigo { font: 600 2em/1 var(--f-mono); letter-spacing: .12em; color: var(--km-ambar); }
  .projecao__qr-mini { width: 4.2em; }
  .projecao__qr-mini svg, .projecao__qr svg { display: block; width: 100%; height: auto; border-radius: 6px; }

  .projecao__palco { padding: 1.6em clamp(1.6em, 6vw, 5em); display: grid; align-content: center; gap: 1.2em; min-height: 0; overflow: hidden; }
  .projecao__aviso { text-align: center; font-size: 1.3em; color: #A9BBC1; }
  .projecao .rotulo { color: var(--km-ambar); font-size: 0.75em; }
  .projecao h1 { font-size: 2.3em; font-weight: 700; max-width: 40ch; }
  .projecao .res-barras { font-size: 1.15em; gap: 0.8em; }
  .projecao .res-barras__trilho { height: 0.9em; }
  .projecao .res-nuvem { font-size: 1.4em; min-height: 0; }

  .projecao__entrada { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2.5em; align-items: center; justify-content: center; }
  .projecao__qr { width: min(42vh, 32vw); }
  .projecao__entrada h1 { font-size: 2.2em; }
  .projecao__entrada p { font-size: 1.3em; color: #A9BBC1; margin-top: 0.5em; }
  .projecao__entrada .projecao__codigo { font-size: 4em; display: block; margin-top: 0.15em; }
  .projecao__entrada .projecao__fechada { font-size: 0.9em; color: var(--km-ambar); }

  .projecao__rodape { display: flex; justify-content: space-between; align-items: center; padding: 0.6em 1.6em; font: 500 0.8em var(--f-mono); color: #A9BBC1; }
  .projecao__botao { border: 1px solid rgba(238, 243, 244, .3); border-radius: 6px; background: none; color: inherit; font: inherit; padding: 0.35em 0.8em; cursor: pointer; }
  :fullscreen .projecao__botao { display: none; }
  @media (max-width: 700px) { .projecao__entrada { grid-template-columns: 1fr; justify-items: center; text-align: center; } .projecao__qr { width: 60vw; } }
</style>
