---
import Base from '../layouts/Base.astro';
import { carregarConteudo } from '../lib/conteudo';

const { configuracoes: cfg, reconhecimentos, palestras, publicacoes, parceiros } = await carregarConteudo();
const grupos = [
  { tipo: 'formacao', titulo: 'Formação' },
  { tipo: 'certificacao', titulo: 'Certificações' },
  { tipo: 'atuacao', titulo: 'Atuação técnica' },
  { tipo: 'premio', titulo: 'Prêmios' },
].map((g) => ({ ...g, itens: reconhecimentos.filter((r) => r.tipo === g.tipo) })).filter((g) => g.itens.length);
---
<Base titulo="Quem somos" descricao={`A KM BIM e seu sócio proprietário, ${cfg.socio_nome}.`}>
  <section class="secao">
    <div class="container secao__cabeca">
      <span class="rotulo">Quem somos</span>
      <h1>KM BIM Consultoria</h1>
      <p>{cfg.sobre_empresa}</p>
    </div>
    <div class="container km">
      <div><strong>K</strong><span>Kyuma</span></div>
      <div><strong>M</strong><span>Marcelo</span></div>
      <div class="km__igual">=</div>
      <div><strong>KM</strong><span>Knowledge Management: gestão do conhecimento aplicada à construção</span></div>
    </div>
  </section>

  <section class="secao secao--alt">
    <div class="container socio">
      <img src={cfg.socio_foto} alt={cfg.socio_nome} width="400" height="600" />
      <div class="socio__texto">
        <span class="rotulo">{cfg.socio_cargo}</span>
        <h2>{cfg.socio_nome}</h2>
        <p class="texto">{cfg.socio_bio}</p>
        {cfg.linkedin_url && (
          <a class="botao botao--primario" href={cfg.linkedin_url} target="_blank" rel="noopener">Ver perfil no LinkedIn</a>
        )}
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="secao__cabeca"><span class="rotulo">Trajetória</span><h2>Formação e reconhecimentos</h2></div>
      <div class="grupos">
        {grupos.map((g) => (
          <div>
            <h3>{g.titulo}</h3>
            <ul class="lista">
              {g.itens.map((r) => (
                <li><strong>{r.titulo}</strong><span>{[r.descricao, r.ano].filter(Boolean).join(' · ')}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {palestras.length > 0 && (
    <section class="secao secao--alt">
      <div class="container">
        <div class="secao__cabeca"><span class="rotulo">Palestras e eventos</span><h2>Compartilhando conhecimento</h2></div>
        <ul class="palestras">
          {palestras.map((p) => (
            <li>
              {p.imagem && <img src={p.imagem} alt="" loading="lazy" />}
              <div>
                <span class="rotulo">{[p.evento, p.ano].filter(Boolean).join(' · ')}</span>
                <strong>{p.link ? <a href={p.link} target="_blank" rel="noopener">{p.titulo}</a> : p.titulo}</strong>
                {p.cidade && <span class="muted">{p.cidade}</span>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {publicacoes.length > 0 && (
    <section class="secao">
      <div class="container">
        <div class="secao__cabeca"><span class="rotulo">Publicações</span><h2>Artigos e trabalhos técnicos</h2></div>
        <ul class="lista lista--pub">
          {publicacoes.map((p) => (
            <li>
              <strong>{p.link ? <a href={p.link} target="_blank" rel="noopener">{p.titulo}</a> : p.titulo}</strong>
              <span>{[p.veiculo, p.ano, /\.pdf($|\?)/i.test(p.link) && 'PDF'].filter(Boolean).join(' · ')}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {parceiros.length > 0 && (
    <section class="secao secao--alt">
      <div class="container">
        <div class="secao__cabeca"><span class="rotulo">Parceiros</span><h2>Rede de execução</h2></div>
        <ul class="parceiros">
          {parceiros.map((p) => (
            <li>
              {p.logo && <img src={p.logo} alt="" loading="lazy" />}
              <strong>{p.site ? <a href={p.site} target="_blank" rel="noopener">{p.nome}</a> : p.nome}</strong>
              {p.descricao && <p class="muted">{p.descricao}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="secao secao--escura">
    <div class="container chamada">
      <h2>Vamos conversar sobre o seu projeto?</h2>
      <a class="botao botao--cta" href="/orcamento">Solicitar orçamento</a>
    </div>
  </section>
</Base>

<style>
  .km { display: flex; flex-wrap: wrap; gap: 12px; align-items: stretch; }
  .km > div { display: grid; gap: 4px; padding: 16px 20px; border: 1px solid var(--line); border-radius: var(--raio); }
  .km > div:last-child { flex: 1 1 280px; border-color: var(--accent); background: #F4F9FA; }
  .km strong { font: 800 2rem/1 var(--f-display); color: var(--accent); }
  .km span { color: var(--muted); font-size: 0.95rem; }
  .km .km__igual { border: 0; place-items: center; font: 700 2rem var(--f-display); color: var(--km-ambar); padding-inline: 4px; }
  .socio { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .socio img { border-radius: var(--raio); width: 100%; }
  .socio__texto { display: grid; gap: 16px; justify-items: start; }
  @media (max-width: 760px) { .socio { grid-template-columns: 1fr; } .socio img { max-width: 320px; } }
  .grupos { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px 40px; }
  .grupos h3 { margin-bottom: 14px; padding-bottom: 8px; border-bottom: 2px solid var(--km-ambar); display: inline-block; }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .lista li { display: grid; gap: 2px; }
  .lista span { color: var(--muted); font-size: 0.92rem; }
  .lista--pub { max-width: 820px; }
  .lista--pub li { padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .palestras { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
  .palestras li { background: #fff; border: 1px solid var(--line); border-radius: var(--raio); overflow: hidden; }
  .palestras img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .palestras div { display: grid; gap: 6px; padding: 16px; }
  .parceiros { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; }
  .parceiros li { display: grid; gap: 8px; padding: 20px; background: #fff; border: 1px solid var(--line); border-radius: var(--raio); }
  .parceiros img { max-height: 48px; width: auto; }
  .chamada { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
</style>
