---
import Base from '../layouts/Base.astro';
import SolucaoCard from '../components/SolucaoCard.astro';
import BarraSelecao from '../components/BarraSelecao.astro';
import { carregarConteudo } from '../lib/conteudo';

const { configuracoes: cfg, categorias, solucoes, parceiros, depoimentos } = await carregarConteudo();
const nomeCategoria = Object.fromEntries(categorias.map((c) => [c.slug, c.nome]));
const destaques = solucoes.filter((s) => s.destaque).slice(0, 6);
const contagem = (slug: string) => solucoes.filter((s) => s.categoria === slug).length;
---
<Base>
  <section class="hero">
    <div class="container hero__grade">
      <div class="hero__texto">
        <span class="rotulo">{cfg.tagline}</span>
        <h1>{cfg.home_titulo}</h1>
        <p>{cfg.home_subtitulo}</p>
        <div class="hero__acoes">
          <a class="botao botao--cta" href="/solucoes">Escolher soluções</a>
          <a class="botao botao--contorno" href="/quem-somos">Conhecer a KM BIM</a>
        </div>
      </div>
      <svg class="hero__via" viewBox="0 0 400 360" aria-hidden="true">
        <g stroke="#2E4A55" stroke-width="1">
          {Array.from({ length: 9 }, (_, i) => <line x1={200} y1={20} x2={-120 + i * 80} y2={360} />)}
          {[60, 110, 170, 250, 350].map((y) => <line x1={0} y1={y} x2={400} y2={y} stroke-dasharray="2 6" />)}
        </g>
        <polygon points="40,360 170,360 196,110 186,110" fill="#EEF3F4" />
        <polygon points="230,360 360,360 214,110 204,110" fill="#EEF3F4" />
        <rect x="70" y="80" width="260" height="22" rx="4" fill="#1BA8B8" />
        <rect x="104" y="102" width="18" height="14" fill="#1BA8B8" />
        <rect x="278" y="102" width="18" height="14" fill="#1BA8B8" />
        {[[330, 360, 12], [270, 300, 9], [222, 248, 6.5], [180, 198, 4.5], [148, 160, 3]].map(([a, b, w]) => (
          <polygon points={`${200 - w},${b} ${200 + w},${b} ${200 + w * 0.8},${a} ${200 - w * 0.8},${a}`} fill="#F2A33A" />
        ))}
        <g font-family="IBM Plex Mono, monospace" font-size="11" fill="#7F959D">
          <text x="398" y="298" text-anchor="end">km 0+300</text>
          <text x="398" y="222" text-anchor="end">km 0+200</text>
          <text x="398" y="168" text-anchor="end">km 0+100</text>
        </g>
      </svg>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <div class="secao__cabeca">
        <span class="rotulo">Como atuamos</span>
        <h2>Do diagnóstico à operação da obra</h2>
        <p>As soluções estão organizadas pelas etapas do ciclo do empreendimento. Você escolhe por onde começar.</p>
      </div>
      <ol class="etapas">
        {categorias.map((c, i) => (
          <li>
            <a href={`/solucoes#${c.slug}`}>
              <span class="etapas__num">Etapa {i + 1}</span>
              <strong>{c.nome}</strong>
              <span>{c.descricao}</span>
              <span class="etapas__qtd">{contagem(c.slug)} {contagem(c.slug) === 1 ? 'solução' : 'soluções'}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao secao--alt">
    <div class="container">
      <div class="secao__cabeca">
        <span class="rotulo">Mais procuradas</span>
        <h2>Monte seu pedido de orçamento</h2>
        <p>Marque as soluções que interessam e envie um único pedido. Respondemos com uma proposta sob medida.</p>
      </div>
      <div class="grade-cards">
        {destaques.map((s) => <SolucaoCard solucao={s} categoria={nomeCategoria[s.categoria]} />)}
      </div>
      <p class="ver-todas"><a href="/solucoes">Ver todas as {solucoes.length} soluções →</a></p>
    </div>
  </section>

  <section class="secao">
    <div class="container socio">
      <img src={cfg.socio_foto} alt={cfg.socio_nome} width="400" height="600" loading="lazy" />
      <div class="socio__texto">
        <span class="rotulo">{cfg.socio_cargo}</span>
        <h2>{cfg.socio_nome}</h2>
        <p class="texto">{cfg.socio_bio}</p>
        <ul class="numeros">
          <li><strong>30+ anos</strong><span>em engenharia e construção</span></li>
          <li><strong>3 edições</strong><span>palestrante na Autodesk University</span></li>
          <li><strong>Poli-USP</strong><span>engenharia civil</span></li>
        </ul>
        <a href="/quem-somos">Trajetória completa →</a>
      </div>
    </div>
  </section>

  {parceiros.length > 0 && (
    <section class="secao secao--alt">
      <div class="container">
        <div class="secao__cabeca">
          <span class="rotulo">Parceiros</span>
          <h2>Execução em escala com quem é referência</h2>
        </div>
        <ul class="parceiros">
          {parceiros.map((p) => (
            <li>{p.logo ? <img src={p.logo} alt={p.nome} loading="lazy" /> : <span>{p.nome}</span>}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {depoimentos.length > 0 && (
    <section class="secao">
      <div class="container">
        <div class="secao__cabeca"><span class="rotulo">Depoimentos</span><h2>Quem trabalhou conosco</h2></div>
        <div class="depoimentos">
          {depoimentos.map((d) => (
            <figure>
              <blockquote>{d.texto}</blockquote>
              <figcaption><strong>{d.autor}</strong>{[d.cargo, d.empresa].filter(Boolean).join(', ')}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="secao secao--escura">
    <div class="container chamada">
      <div>
        <span class="rotulo">Próximo passo</span>
        <h2>Conte o seu desafio. A proposta sai sob medida.</h2>
      </div>
      <a class="botao botao--cta" href="/orcamento">Solicitar orçamento</a>
    </div>
  </section>

  <BarraSelecao />
</Base>

<style>
  .hero { background: var(--km-grafite); color: var(--km-nevoa); overflow: hidden; }
  .hero__grade { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 32px; align-items: center; padding-block: clamp(56px, 8vw, 104px); }
  .hero__texto { display: grid; gap: 22px; }
  .hero .rotulo { color: var(--km-ambar); }
  .hero p { color: #B9C8CD; font-size: 1.15rem; max-width: 60ch; }
  .hero__acoes { display: flex; gap: 12px; flex-wrap: wrap; padding-top: 6px; }
  .hero__via { width: 100%; max-width: 440px; justify-self: end; overflow: visible; }
  @media (max-width: 860px) { .hero__grade { grid-template-columns: 1fr; } .hero__via { max-width: 320px; justify-self: center; } }

  .etapas { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .etapas a { display: grid; gap: 6px; height: 100%; padding: 20px 18px; border: 1px solid var(--line); border-top: 4px solid var(--accent); border-radius: var(--raio); color: var(--fg); text-decoration: none; }
  .etapas a:hover { border-color: var(--accent); background: #F7FAFA; }
  .etapas strong { font: 700 1.3rem var(--f-display); }
  .etapas span { color: var(--muted); font-size: 0.95rem; }
  .etapas .etapas__num { font: 500 0.75rem var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); }
  .etapas .etapas__qtd { margin-top: auto; padding-top: 8px; font: 500 0.8rem var(--f-mono); color: var(--fg); }
  @media (max-width: 980px) { .etapas { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); } }

  .grade-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; }
  .ver-todas { margin-top: 28px; font-weight: 600; }

  .socio { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .socio img { border-radius: var(--raio); width: 100%; }
  .socio__texto { display: grid; gap: 16px; justify-items: start; }
  .numeros { list-style: none; margin: 8px 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; width: 100%; }
  .numeros li { display: grid; gap: 2px; border-left: 3px solid var(--km-ambar); padding-left: 12px; }
  .numeros strong { font: 800 1.5rem/1.1 var(--f-display); }
  .numeros span { color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 760px) { .socio { grid-template-columns: 1fr; } .socio img { max-width: 320px; } .numeros { grid-template-columns: 1fr; } }

  .parceiros { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; }
  .parceiros img { max-height: 56px; width: auto; }
  .parceiros span { font: 700 1.2rem var(--f-display); }

  .depoimentos { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; }
  .depoimentos figure { margin: 0; padding: 24px; border: 1px solid var(--line); border-radius: var(--raio); display: grid; gap: 16px; }
  .depoimentos blockquote { margin: 0; font-size: 1.05rem; }
  .depoimentos figcaption { display: grid; color: var(--muted); font-size: 0.92rem; }
  .depoimentos figcaption strong { color: var(--fg); }

  .chamada { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .chamada > div { display: grid; gap: 10px; max-width: 640px; }
</style>
