---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página não encontrada" semIndexar>
  <section class="secao">
    <div class="container secao__cabeca">
      <span class="rotulo">Erro 404</span>
      <h1>Este trecho da obra ainda não existe</h1>
      <p>A página que você procurou não foi encontrada. Ela pode ter mudado de endereço.</p>
      <p><a class="botao botao--primario" href="/">Ir para a página inicial</a></p>
    </div>
  </section>
</Base>
